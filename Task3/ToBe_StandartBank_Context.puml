@startuml
title Bank Standard Context Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Person(client, "Client", "Authorized Bank Client")
Person(manager, "Manager", "Back-office manager")

System(StandartBankSystem, "Bank Standart System", "System managing bank products")

System_Boundary(StandartBankSystem, "Standart Bank System") {
    System(InternetBankSystem, "Internet-Bank", "Internet Bank system")
    System(ABS, "ABS", "System managing deposits, credits and bills")
    System(SMSConnector, "SMS Connector", "Send SMS to telecom operator gateway")
}

System_Ext(sms_gateway_telecom_operator, "SMS Gateway", "External API for SMS integration")

Rel(client, InternetBankSystem, "Uses the system")
Rel(InternetBankSystem, ABS, "Uses the system")

Rel(manager, ABS, "Uses the system")
Rel(ABS, SMSConnector, "Sends sms")
Rel(SMSConnector, sms_gateway_telecom_operator, "Sends sms")

@enduml